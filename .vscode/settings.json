{
  "typescript.check.workspaceVersion": false,

  "workbench.colorCustomizations": {
    "activityBar.background": "#45a827cb",
    "statusBar.background": "#4e9f41",
    "statusBar.debuggingBackground": "#15d8ff"
  },

  "editor.rulers": [
    80,
    120
  ],

  "html.format.wrapAttributes": "force-aligned",
  "workbench.colorTheme": "Default Light+",

  "files.exclude": {
    "_changelog": true,
    ".sass-cache": true,
    ".sourcemaps": true,
    ".DS_Store": true,
    "npm-debug.log": true,
    "yarn-error.log": true,
    "testem.log": true,
    "connect.lock": true,
    "node_modules": true,
    "libpeerconnection.log": true,
    "dist": true,
    "coverage": true,
    "Thumbs.db": true,
    "browser": true,
    "websql": true,
    "dist-nocutsrc": true,
    "package-lock.json": true,
    "chrome-profiler-events*.json": true,
    "speed-measure-plugin*.json": true,
    "tmp*": true,
    "npm-debug.log*": true,
    "*.filetemplate": true,
    ".gitignore": true,
    "package.json": true,
    ".npmignore": true,
    ".babelrc": true,
    ".editorconfig": true,
    "eslint.config.js": true,
    "protractor.conf.js": true,
    "karma.conf.js": true,
    ".prettierc": true,
    "angular.json": true,
    ".prettierrc.json": true,
    ".eslintrc.js": true,
    ".eslintrc.json": true,
    ".npmrc": true,
    ".yarnrc": true,
    ".idea": true,
    ".prettierignore": true,
    ".prettierrc": true,
    "run.js": true,
    "index.d.ts": true,
    "index.js": true,
    "index.js.map": true,
    "update-vscode-package-json.js": true,
    "tsconfig*": true,
    "webpack.*": true,
    ".eslintrc*": true,
    "tslint.*": true,
    "*.schema.json": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/browser": true,
    "**/websql": true,
    "eslint-rules": true,
    "dist-prod": true,
    "dist-nocutsrc-prod": true,
    "*.i18n.data.ts": true,
    "**/*.i18n.data.ts": true,
    "tmp-*": true,
    "**/tmp-*": true,
    "dist*": true,
    "**/dist*": true,
    ".tnp": true,
    "**/.tnp": true,
    "AGENTS.md": true,
    "**/AGENTS.md": true,
    ".ai": true,
    "**/.ai": true,
    ".github/copilot-instructions.md": true,
    "**/.github/copilot-instructions.md": true,
    ".ai/examples": true,
    "**/.ai/examples": true,
    ".taon": true,
    "**/.taon": true,
    "**/tsconfig*": true,
    "**/*.schema.json": true,
    "eslint*": true,
    "**/eslint*": true,
    "**/run.js": true,
    "webpack*": true,
    "**/webpack*": true,
    "**/index.js": true,
    "**/index.js.map": true,
    "**/index.d.ts": true,
    "vitest.config.ts": true,
    "**/vitest.config.ts": true,
    "**/.gitignore": true,
    "**/.npmignore": true,
    "**/.npmrc": true,
    "**/.prettierrc": true,
    "**/.prettierignore": true,
    "**/update-vscode-package-json.js": true,
    "**/.editorconfig": true,
    "**/package.json": true,
    "**/*.filetemplate": true,
    "!templates-subprojects/**/package.json": true
  },

  "search.exclude": {
    "bin": true,
    "local_release": true,
    "node_modules": true,
    ".build": true,
    ".vscode": true,
    "browser": true,
    "dist": true,
    "package-lock.json": true,
    "tmp-*": true,
    "src/lib/env/**/*.*": true,
    ".firedev": true,
    ".taon": true,
    ".tnp": true,
    "**/bin": true,
    "**/local_release": true,
    "**/node_modules": true,
    "**/.build": true,
    "**/.vscode": true,
    "**/browser": true,
    "**/dist": true,
    "**/package-lock.json": true,
    "**/tmp-*": true,
    "**/src/lib/env/**/*.*": true,
    "**/.firedev": true,
    "**/.taon": true,
    "**/.tnp": true,
    "projects": true,
    "dist-*": true,
    "**/dist-*": true,
    "*.rest": true,
    "**/*.rest": true,
    "src/app.auto-gen-docs.md": true,
    "src/app.auto-gen-ver.js": true
  },

  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[json5]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "eslint.migration.2_x": "off",
  "eslint.enable": true,
  "prettier.enable": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.inlineSuggest.enabled": true,
  "prettier.endOfLine": "auto",
  "prettier.prettierPath": "./node_modules/prettier",
  "window.title": "taon-dev/ng2-rest-swagger-generator () [ ${activeEditorShort}]",
  "search.useIgnoreFiles": false,

  "search.include": [
    "**/src/**"
  ],

  "json.schemas": [
    {
      "fileMatch": [
        "/docs-config.jsonc"
      ],
      "url": "./docs-config.schema.json"
    },
    {
      "fileMatch": [
        "/taon.jsonc"
      ],
      "url": "./taon-config-standalone.schema.json"
    }
  ],

  "files.watcherExclude": {
    "local_release/**": true,
    "tmp-*/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dist-nocutsrc/**": true
  },

  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "[dockercompose]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },

  "typescript.suggest.autoImports": false,
  "javascript.suggest.autoImports": false,

  "files.associations": {
    "tsconfig.json": "plaintext",
    "**/tsconfig.json": "plaintext",
    "**/tsconfig.*.json": "plaintext"
  },

  "search.followSymlinks": false
}
